cmake_minimum_required(VERSION 3.20)
project(WasmMigrator CXX)

set(CMAKE_CXX_STANDARD 20)
set(CMAKE_CXX_STANDARD_REQUIRED ON)

# Link Homebrew header and library paths
include_directories(/opt/homebrew/include)
link_directories(/opt/homebrew/lib)

add_executable(wasm_migrator
        src/main.cpp
        src/snapshot.cpp
        src/network.cpp
)
target_link_libraries(wasm_migrator PRIVATE wasmtime)
